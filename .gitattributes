# Normalize line endings on checkout to match .editorconfig settings.
# Without this, git on Linux checks out files with LF regardless of .editorconfig,
# causing dotnet format --verify-no-changes to fail in CI.

# Default: normalize to LF in the repo, checkout as-is
* text=auto

# C# and VB source files — .editorconfig mandates CRLF; enforce on checkout
*.cs text eol=crlf
*.vb text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf

# Shell scripts — always LF
*.sh text eol=lf

# Windows scripts — always CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# YAML — LF (Linux runners, Docker)
*.yml text eol=lf
*.yaml text eol=lf

# Markdown and JSON — LF
*.md text eol=lf
*.json text eol=lf

# HTML — LF. docs/development/ahk-workflow.pdf.source.sha256 records the SHA-256 of the
# cheatsheet HTML, and that hash changes with the line endings. Without this rule
# core.autocrlf=true checks the file out as CRLF on Windows and the freshness check fails
# on a clean clone.
*.html text eol=lf

# Friction evidence — verbatim transcript text, so no whitespace check.
# Every row carries a message exactly as it was written, and some of those messages end lines
# with a space. Stripping it to satisfy `git diff --check` would edit the evidence a label was
# written against, which is the one thing these files exist to prevent.
docs/development/friction-samples/*.csv -whitespace
docs/development/friction-samples/ledgers/*.csv -whitespace

# Binaries — no line ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.dll binary
*.exe binary
