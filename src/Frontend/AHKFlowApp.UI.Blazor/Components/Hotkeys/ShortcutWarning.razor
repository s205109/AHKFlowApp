@using AHKFlowApp.UI.Blazor.DTOs
@using AHKFlowApp.UI.Blazor.Helpers
@using AHKFlowApp.UI.Blazor.Services
@using MudBlazor
@implements IDisposable

@* Advisory only — this never gates a save. Both places a hotkey's keys can be changed render
   it: the edit dialog and the grid's inline row. One alert holds both notices: they carry the
   same severity and the same advice, so two boxes would only add noise. *@
@if (SourceSection || _destinationWarning is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2"
              UserAttributes="@(new Dictionary<string, object?> { ["data-test"] = "shortcut-warning" })">
        @if (SourceSection)
        {
            @* Labels only when a destination notice is also present. A source-side-only notice
               then reads exactly as it read before the destination check existed. *@
            @if (BothSections)
            {
                <MudText Typo="Typo.subtitle2">Key and modifiers</MudText>
            }
            @if (_sourceWarning is not null)
            {
                <div data-test="source-warning">@_sourceWarning</div>
            }
            @* Second, because the known-shortcut notice is about the wider world and this one is
               about the owner's own profile. Both describe the keys pressed, so they share a
               section. *@
            @if (_templateWarning is not null)
            {
                <div data-test="template-warning">@_templateWarning</div>
            }
        }
        @if (_destinationWarning is not null)
        {
            @if (BothSections)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">Remap destination</MudText>
            }
            <div data-test="destination-warning">@_destinationWarning</div>
        }
    </MudAlert>
}
@* Outside the @if, so it renders on every pass. It is how an E2E test can tell "no warning"
   apart from "not decided yet". Hidden: it is not for the reader. *@
<span data-test="shortcut-warning-checked"
      data-combination="@_checked"
      data-destination="@_checkedDestination"
      style="display:none"></span>

@code {
    [Parameter] public string? Key { get; set; }
    [Parameter] public bool Ctrl { get; set; }
    [Parameter] public bool Alt { get; set; }
    [Parameter] public bool Shift { get; set; }
    [Parameter] public bool Win { get; set; }

    [Parameter] public HotkeyActionKind ActionKind { get; set; }

    /// <summary>Destination of a Remap row. Ignored for every other action kind.</summary>
    [Parameter] public string? RemapDest { get; set; }

    /// <summary>Every Profile the owner has, with their templates. Both call sites already hold this.</summary>
    /// <remarks>
    /// The Hotkeys page fills this list from its own request, so the grid can render an editable row
    /// before the list arrives. The templates the notice reads are therefore part of
    /// <see cref="EvaluationKey"/>: a list that lands later re-evaluates instead of leaving a row
    /// that can never warn.
    /// </remarks>
    [Parameter] public IReadOnlyList<ProfileDto> Profiles { get; set; } = [];

    /// <summary>The Profiles this row belongs to. Ignored when <see cref="AppliesToAllProfiles"/> is true.</summary>
    [Parameter] public IReadOnlyCollection<Guid> ProfileIds { get; set; } = [];

    [Parameter] public bool AppliesToAllProfiles { get; set; }

    [Inject] private IHotkeyKeyCatalog Keys { get; set; } = default!;
    [Inject] private IKnownShortcutCatalog KnownShortcuts { get; set; } = default!;
    [Inject] private ILogger<ShortcutWarning> Logger { get; set; } = default!;

    // The notice for the keys the user presses, or null when nothing uses them.
    private string? _sourceWarning;

    // The notice for a Remap row's destination, or null when the destination says nothing.
    private string? _destinationWarning;

    // The notice for a Profile template that already uses this row's key, or null when none does.
    private string? _templateWarning;

    private bool SourceSection => _sourceWarning is not null || _templateWarning is not null;

    private bool BothSections => SourceSection && _destinationWarning is not null;

    // The combination the notices above were last decided for, or "" before the first decision,
    // and the canonical destination that decision used. Set together with the notices and under
    // the same generation check, so neither announces a decision a newer state has replaced. Read
    // only by the tests: they are how a test tells "no warning" from "not evaluated yet".
    private string _checked = "";
    private string _checkedDestination = "";

    // What one evaluation was for. The source combination alone is not enough: switching the
    // action kind, picking a new destination, changing which Profiles the row belongs to, or
    // receiving the Profile list itself all change the notice while the combination stands still.
    private readonly record struct EvaluationKey(
        string Combination,
        HotkeyActionKind Kind,
        string? RemapDest,
        string ProfileScope,
        string Templates);

    private EvaluationKey? _evaluated;

    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _shortcutCts;
    private int _generation;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        string combination = HotkeyActionDisplay.ComboLabel(Key ?? "", Ctrl, Alt, Shift, Win);
        EvaluationKey key = new(combination, ActionKind, RemapDest, ProfileScope(), TemplateStamp());

        if (key == _evaluated)
            return;

        _evaluated = key;
        _ = RefreshAsync(key);
    }

    // Sorted, so reordering the multi-select does not force a pointless re-evaluation.
    private string ProfileScope() =>
        AppliesToAllProfiles ? "*" : string.Join(",", ProfileIds.Order());

    // Everything the notice reads, from exactly the Profiles it reads it from: the name it
    // prints, and the two templates it matches the row against. A longer list, a renamed
    // Profile, or an edited template each produce a different stamp, so the notice follows
    // every one of them. The separators are the ASCII record and unit separators, which no
    // AutoHotkey template holds, so text moved from the header to the footer changes the stamp
    // instead of reading the same both ways.
    private const string FieldSeparator = "\u001E";
    private const string ProfileSeparator = "\u001F";

    private string TemplateStamp() =>
        string.Join(ProfileSeparator, SelectedProfiles().Select(p => string.Join(
            FieldSeparator, p.Id, p.Name, p.HeaderTemplate, p.FooterTemplate)));

    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        _shortcutCts?.Cancel();
        _shortcutCts?.Dispose();
        _shortcutCts = null;
    }

    /// <summary>
    /// Refreshes the notice for one combination. Fire-and-forget from <c>OnParametersSet</c>: the
    /// notice is advisory, so nothing waits on it.
    /// </summary>
    /// <remarks>
    /// A response for an older combination is dropped rather than rendered, so holding a modifier
    /// key down cannot leave a stale notice on screen. A failed fetch clears the source notice and
    /// says nothing there — a list that will not load must never confuse saving. It still decides
    /// the destination notice, whose modifier rule needs no list.
    /// </remarks>
    private async Task RefreshAsync(EvaluationKey key)
    {
        _shortcutCts?.Cancel();
        _shortcutCts?.Dispose();
        CancellationTokenSource cts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        _shortcutCts = cts;
        int generation = ++_generation;

        // Read once, before the first await. A newer evaluation cancels and disposes this source,
        // and reading Token on a disposed source throws ObjectDisposedException. That is not an
        // OperationCanceledException, so it would reach the catch below and log a list-read failure
        // that never happened.
        CancellationToken token = cts.Token;

        // Declared out here so the catch can report the destination it had already resolved.
        string? canonicalDest = null;

        try
        {
            string canonical = await Keys.CanonicalizeAsync(Key, token);

            // Only a Remap has a destination. Every other kind may still carry a stale value: the
            // edit model keeps per-kind fields across kind switches on purpose.
            // A key registry that failed to load hands the key back unchanged, so an alias such as
            // "Win" stays "Win" and matches no modifier. This feature is advisory, so a miss is the
            // safe outcome.
            if (key.Kind == HotkeyActionKind.Remap && !string.IsNullOrWhiteSpace(key.RemapDest))
                canonicalDest = await Keys.CanonicalizeAsync(key.RemapDest, token);

            List<ProfileTemplateUse> templateUses = await TemplateUsesAsync(token);

            // Session-cached: only the first call in a session reaches the network. The generation
            // check below still earns its place, because that first call can be slow enough for the
            // user to change the combination while it is in flight.
            KnownShortcutCatalogDto? catalog = await KnownShortcuts.GetAsync(token);

            if (generation != _generation || _disposed)
                return;

            string? templateNotice = TemplateUseText.TextFor(
                templateUses,
                new RowCombination(canonical, Ctrl, Alt, Shift, Win, key.Combination));

            if (catalog is null)
            {
                // The fetch failed. The source side says nothing, because deciding it needs the
                // list, but leave a trace in the browser console. The cache does not memoize the
                // failure, so the next evaluation retries.
                // The destination side is still decided. Its modifier rule reads the destination
                // key alone, so an outage must not take that notice away.
                Logger.LogWarning("Known-shortcut list could not be read; showing no source warning.");
                Decide(source: null, templateNotice,
                    DestinationNotice(null, canonical, canonicalDest, key), key, canonicalDest);
                return;
            }

            KnownShortcutDto? match = KnownShortcutWarning.Match(catalog, canonical, Ctrl, Alt, Shift, Win);

            Decide(
                match is null ? null : KnownShortcutWarning.TextFor(match, key.Combination),
                templateNotice,
                DestinationNotice(catalog, canonical, canonicalDest, key),
                key,
                canonicalDest);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer evaluation, or the host went away. Nothing to show.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Known-shortcut list could not be read; showing no warning.");

            // The decision is still announced, so a waiting test finishes instead of hanging. It
            // carries whatever destination was resolved before the throw. Reading the list is not
            // the only step that can fail, and "" would read as "not evaluated yet".
            if (generation == _generation && !_disposed)
                Decide(source: null, template: null, destination: null, key, canonicalDest);
        }
    }

    // The destination notice, or null when there is no source key to name. The notice names the
    // source combination twice, and a new row can reach Remap and a destination before its key is
    // picked. Modifiers alone make the label "Ctrl+" — not blank, but still naming no key. Either
    // one would render "This hotkey makes  act as Ctrl." The source side needs no such guard,
    // because Match ignores a blank key.
    private static string? DestinationNotice(
        KnownShortcutCatalogDto? catalog,
        string canonicalSource,
        string? canonicalDest,
        EvaluationKey key) =>
        string.IsNullOrWhiteSpace(canonicalSource)
            ? null
            : KnownShortcutWarning.DestinationTextFor(catalog, canonicalDest, key.Combination);

    // Canonicalizing every parsed key is what lets a template spelling such as "Capital" match a
    // row on "CapsLock". The registry is session-cached, so only the first call reaches the network.
    private async Task<List<ProfileTemplateUse>> TemplateUsesAsync(CancellationToken token)
    {
        List<ProfileTemplateUse> uses = [];

        foreach (ProfileDto profile in SelectedProfiles())
        {
            uses.Add(new ProfileTemplateUse(
                profile.Name,
                await CanonicalHotkeysAsync(profile.HeaderTemplate, token),
                await CanonicalHotkeysAsync(profile.FooterTemplate, token)));
        }

        return uses;
    }

    private IEnumerable<ProfileDto> SelectedProfiles() =>
        AppliesToAllProfiles ? Profiles : Profiles.Where(p => ProfileIds.Contains(p.Id));

    private async Task<List<TemplateHotkey>> CanonicalHotkeysAsync(string template, CancellationToken token)
    {
        List<TemplateHotkey> canonical = [];

        foreach (TemplateHotkey hotkey in TemplateKeyUses.Parse(template))
            canonical.Add(hotkey with { Key = await Keys.CanonicalizeAsync(hotkey.Key, token) });

        return canonical;
    }

    // A list that will not load has still finished deciding. Saying so keeps the E2E wait honest
    // instead of hanging.
    private void Decide(
        string? source,
        string? template,
        string? destination,
        EvaluationKey key,
        string? canonicalDest)
    {
        _sourceWarning = source;
        _templateWarning = template;
        _destinationWarning = destination;
        _checked = key.Combination;
        _checkedDestination = canonicalDest ?? "";
        StateHasChanged();
    }
}
