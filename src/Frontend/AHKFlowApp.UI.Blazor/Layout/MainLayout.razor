@inherits LayoutComponentBase
@using AHKFlowApp.UI.Blazor.Services
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* The E2E first page load diagnosis waits for this marker. Its presence is the proof that the app
   started: Blazor is running, a route matched, and the layout rendered. It says nothing about
   whether the page's own data has arrived. *@
<MudLayout data-test="app-shell">
    @* The first Tab stop on every page. A #main-content link would go to the home page, because
       the app sets <base href="/" />, so the button moves focus in code instead. *@
    <MudButton Class="skip-link" Variant="Variant.Filled" Color="Color.Secondary"
               OnClick="SkipToContentAsync">Skip to main content</MudButton>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Class="drawer-toggle" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer"
                       UserAttributes="@(new Dictionary<string, object?> { ["aria-label"] = _drawerOpen ? "Close navigation menu" : "Open navigation menu" })" />
        <MudText Typo="Typo.h6" Class="ml-3" data-test="app-title">AHKFlowApp</MudText>
        <MudSpacer />
        <MudIconButton Class="dark-mode-toggle" Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkMode"
                       UserAttributes="@(new Dictionary<string, object?> { ["aria-label"] = _isDarkMode ? "Switch to light mode" : "Switch to dark mode" })" />
        <LoginDisplay />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-6">
            <div id="main-content" tabindex="-1" @ref="_mainContent">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Inject] private IUserPreferencesService Preferences { get; set; } = default!;

    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private ElementReference _mainContent;

    protected override async Task OnInitializedAsync()
    {
        Preferences.OnChange += OnPreferencesChanged;
        UserPreferences prefs = await Preferences.GetAsync();
        _isDarkMode = prefs.DarkMode;
    }

    private async void OnPreferencesChanged(UserPreferences prefs)
    {
        _isDarkMode = prefs.DarkMode;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Preferences.OnChange -= OnPreferencesChanged;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task SkipToContentAsync() => await _mainContent.FocusAsync();

    private async Task ToggleDarkMode()
    {
        UserPreferences current = await Preferences.GetAsync();
        await Preferences.SetAsync(current with { DarkMode = !current.DarkMode });
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6AA84F",
            Secondary = "#3B8FC2",
            Tertiary = "#8C3A3A",
            Background = "#F5FAF3",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#6AA84F",
            Secondary = "#3B8FC2",
            Tertiary = "#8C3A3A",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
            H1 = new H1Typography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
            H2 = new H2Typography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
            H3 = new H3Typography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
            H4 = new H4Typography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
            H5 = new H5Typography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
            H6 = new H6Typography { FontFamily = ["Inter", "Roboto", "sans-serif"] },
        },
    };
}
