@using AHKFlowApp.UI.Blazor.Helpers
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject TimeProvider Clock

<AuthorizeView>
    <Authorized>
        @{
            string? greeting = Greeting.Build(Clock, context.User.Identity!.Name);
        }
        @if (greeting is not null)
        {
            <MudText Typo="Typo.body2" Class="mr-2">@greeting</MudText>
        }
        @* Local-install mode has no real sign-in, so there is nothing to sign out of. This used to
           be a permanently disabled button with the reason in a tooltip. A tooltip on a disabled
           button never reaches a keyboard user or a touch user, and a control that can never work
           is not a control. Plain text reaches everyone.

           HtmlTag="span" is required. MudText maps Typo.body2 to a <p>, and a block element would
           break the app bar's inline row. Class="mr-2" matches the greeting beside it. *@
        @if (_useTestAuth)
        {
            <MudText Typo="Typo.body2" HtmlTag="span" Class="mr-2"
                     data-test="local-install-note">Local install — no sign-out</MudText>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Inherit"
                       OnClick="@(() => Navigation.NavigateToLogout("authentication/logout"))">Log out</MudButton>
        }
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Text" Color="Color.Inherit"
                   OnClick="@(() => Navigation.NavigateTo("authentication/login"))">Log in</MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _useTestAuth;

    protected override void OnInitialized()
        => _useTestAuth = Configuration.GetValue<bool>("Auth:UseTestProvider");
}
